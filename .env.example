# ========================================
# English Diagnosis App - 環境変数
# ========================================
# このファイルをコピーして .env を作成してください
# cp .env.example backend/.env

# --- データベース ---
# 開発: SQLite
DATABASE_URL=sqlite:///./english_app.db
# 本番: PostgreSQL
# DATABASE_URL=postgresql://user:password@host:5432/english_app

# --- セキュリティ ---
# CORS許可オリジン（カンマ区切り）
# 本番では実際のドメインを指定
# ALLOWED_ORIGINS=https://english-diagnosis.onrender.com

# --- デバッグ ---
# true: ログ詳細化 + Swagger UI有効
# 本番では必ず false
DEBUG=true

# --- AI（将来利用） ---
# ANTHROPIC_API_KEY=sk-ant-your-key-here

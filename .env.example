# ========================================
# English Diagnosis App - 環境変数
# ========================================
# このファイルをコピーして .env を作成してください
# cp .env.example backend/.env

# --- データベース ---
# 開発: SQLite
DATABASE_URL=sqlite:///./english_app.db
# 本番: Supabase PostgreSQL（無料・無期限）
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# --- セキュリティ ---
# CORS許可オリジン（カンマ区切り）
# 本番では実際のドメインを指定
# ALLOWED_ORIGINS=https://english-diagnosis.onrender.com

# --- デバッグ ---
# true: ログ詳細化 + Swagger UI有効
# 本番では必ず false
DEBUG=true
